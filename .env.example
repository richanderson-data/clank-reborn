# Copy to .env and edit. .env is gitignored and never committed.

# Ollama is the only supported provider. This legacy setting may be omitted.
CLANK_PROVIDER=ollama

# Model name. Required unless you pass --model on the command line.
# Examples: qwen3.5:4b, gpt-oss:20b, qwen2.5-coder:14b
CLANK_MODEL=

# Ollama server address
CLANK_OLLAMA_HOST=http://localhost:11434

# Where conversation history is stored locally
# CLANK_DB_PATH=C:\path\to\clank.db

# How many recent messages are sent to the model (tool messages included)
CLANK_MAX_HISTORY=40

# Tool rounds per task; progress inspection every 20 rounds does not stop work
CLANK_MAX_TOOL_ROUNDS=100

# Public search, page reading, and city weather; false keeps web tools offline
CLANK_WEB_ENABLED=true

# Seconds to wait for streamed chunks before treating the stream as stalled
CLANK_REQUEST_TIMEOUT=300
